+static void setChannelSoundingEphemeralLtkNative(JNIEnv* env, jobject /* object */, jstring address,
+                                                 jbyteArray ltk) {
+  if (!sGattIf || ltk == nullptr) {
+    return;
+  }
+  Octet16 octet_ltk{};
+  jsize len = env->GetArrayLength(ltk);
+  if (len != static_cast<jsize>(octet_ltk.size())) {
+    log::error("Invalid ephemeral LTK length: {}", len);
+    return;
+  }
+  env->GetByteArrayRegion(ltk, 0, static_cast<jsize>(octet_ltk.size()),
+                          reinterpret_cast<jbyte*>(octet_ltk.data()));
+  sGattIf->distance_measurement_manager->SetEphemeralOobLtk(str2addr(env, address), octet_ltk);
+}
+
+static void clearChannelSoundingEphemeralLtkNative(JNIEnv* env, jobject /* object */,
+                                                   jstring address) {
+  if (!sGattIf) {
+    return;
+  }
+  sGattIf->distance_measurement_manager->ClearEphemeralOobLtk(str2addr(env, address));
+}
